#!/usr/bin/env bash

function indent() {
	c='s/^/       /'
	case $(uname) in
		Darwin) sed -l "$c";;
		*)      sed -u "$c";;
	esac
}

ENV_DIR=${3:-}
ssh_key="$( cat ${ENV_DIR}/SSH_KEY )"
ssh_hosts="${SSH_HOSTS:-"git@github.com"}"

#
# !! WARNING !!
# OpenSSH doesn't use $HOME.
# Consequently, we have to:
# - use a variable ($build_home) to point to the **real** home directory
#   when in build phase (which is different than the one pointed by $HOME).
# - use another one ($run_home) to point to the home directory
#   when in run phase.
# - copy the generated files in $build_home to $run_home at the end
#   of the process.
#

if [ -n "${ssh_key}" ]; then
	echo "-----> Running SSH private key setup"

	# Path to the ssh directory when in BUILD phase:
	build_home="$( getent passwd "$( whoami )" | cut -d ':' -f6 )/.ssh"

	# Path to the ssh directory when in RUN phase:
	run_home="${HOME}/.ssh"

	id_file="${build_home}/id_rsa"

	mkdir --parents "${build_home}" "${run_home}"

	# Create the SSH private key:
	echo "${ssh_key}" | base64 --decode > "${id_file}"

	chmod 700 "${build_home}" "${run_home}"
	chmod 400 "${id_file}"

	if [ -n "${BUILDPACK_DEBUG}" ]; then
		echo "Successfully imported SSH key to ${id_file}" | indent
	fi

	# Populate the known_hosts file:
	IFS=',' read -ra HOST <<< "${ssh_hosts}"
	for i in "${HOST[@]}"; do
		ssh -oStrictHostKeyChecking=no -T "${i}" -i "${id_file}" 2>&1 | indent
	done

	# Now that everything is setup in build_home,
	# copy the files to run_home so they are available at RUN time:
	cp --archive "${build_home}/." "${run_home}/"
	chmod 400 "${run_home}/id_rsa"

	if [ -n "${BUILDPACK_DEBUG}" ]; then
		echo "Successfully copied SSH files to ${run_home}" | indent
	fi

	exit 0
else
	echo "-----> No SSH private key"
fi

#!/usr/bin/env bash

function indent() {
	c='s/^/       /'
	case $(uname) in
		Darwin) sed -l "$c";;
		*)      sed -u "$c";;
	esac
}

ENV_DIR=${3:-}
ssh_key="$( cat ${ENV_DIR}/SSH_KEY )"
ssh_hosts="${SSH_HOSTS:-"git@github.com"}"

if [ -n "${ssh_key}" ]; then
	echo "-----> Running SSH private key setup"

	ssh_home="${HOME}/.ssh"
	id_file="${ssh_home}/id_rsa"

	mkdir --parents "${ssh_home}"

	echo "${ssh_key}" | base64 --decode > "${id_file}"

	chmod 700 "${ssh_home}"
	chmod 400 "${id_file}"

	if [ -n "${BUILDPACK_DEBUG}" ]; then
		echo "Successfully imported SSH key to ${id_file}" | indent
	fi

	IFS=',' read -ra HOST <<< "${ssh_hosts}"
	for i in "${HOST[@]}"; do
		ssh -oStrictHostKeyChecking=no \
			-oUserKnownHostsFile="${ssh_home}/known_hosts" \
			-T "${i}" -i "${id_file}" 2>&1 | indent
	done

	exit 0
else
	echo "-----> No SSH private key"
fi
